# Supabase: o formulário de contato grava na tabela public.contact_messages.
# Só são lidas no servidor (route handler /api/contato); nunca vão para o navegador.
# NÃO use o prefixo NEXT_PUBLIC_ nessas variáveis.
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave secreta (sb_secret_...) ou a legada service_role. Painel > Project Settings > API Keys.
SUPABASE_SECRET_KEY=
# Senha que a Vercel envia ao chamar o cron /api/keep-alive. Gere com: openssl rand -hex 24
CRON_SECRET=
